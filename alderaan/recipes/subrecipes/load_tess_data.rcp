import os
import sys
import warnings

from astropy.stats import mad_std
import numpy as np

from alderaan.ephemeris import Ephemeris
from alderaan.litecurve import TessLiteCurve
from alderaan.planet import Planet
from alderaan.modules.quicklook import plot_litecurve
from alderaan.utils.io import fetch_toi_table, parse_toi_catalog
from alderaan.utils.pipeline import capture_locals
from alderaan.utils.stats import set_sigma_cutoff


@capture_locals
def run(context):
    print("\n\nSUBRECIPE: LOAD TESS DATA\n")

    # infer context
    target = context.target

    # fetch and parse TOI catalog
    toi_csv = fetch_toi_table(context.catalog_dir)
    catalog = parse_toi_catalog(toi_csv, target)

    assert np.all(np.diff(catalog.period) > 0), "Planets should be ordered by ascending period"

    NPL = int(catalog.npl[0])
    tic_id = int(catalog.tic_id[0])
    limbdark = [catalog.limbdark_1[0], catalog.limbdark_2[0]]

    # load lightcurves via lightkurve (with caching)
    sectors = getattr(context, 'sectors', None)
    litecurve_master = TessLiteCurve.load_tess_pdcsap(
        tic_id,
        data_dir=context.data_dir,
        sectors=sectors,
    )

    t_min = litecurve_master.time.min()
    t_max = litecurve_master.time.max()
    if t_min < 0:
        raise ValueError("Lightcurve has negative timestamps...this will cause problems")

    # split litecurves by sector (visit)
    litecurves = litecurve_master.split_visits()

    for j, lc in enumerate(litecurves):
        assert len(np.unique(lc.visit)) == 1, "expected one sector per litecurve"
        assert len(np.unique(lc.obsmode)) == 1, "expected one obsmode per litecurve"

    print(f"{len(litecurves)} litecurves loaded for {target}")

    # Build segment ranges from observed sectors
    # Only keep transit times that fall within actual data, not in gaps
    segment_ranges = []
    for lc in litecurves:
        segment_ranges.append((lc.time.min(), lc.time.max()))

    # initialize planets with linear ephemeris (no Holczer TTVs for TESS)
    with warnings.catch_warnings(record=True) as catch:
        warnings.simplefilter('always', category=UserWarning)
        planets = [None]*NPL
        for n in range(NPL):
            planets[n] = Planet(catalog, target, n)

    print(f"\n{NPL} planets loaded for {target}")
    print([np.round(p.period,6) for p in planets])

    # update planet ephemerides with linear ephemeris, filtered to observed sectors
    for n, p in enumerate(planets):
        if p.ephemeris is None:
            _ephemeris = Ephemeris(period=p.period, epoch=p.epoch, t_min=t_min, t_max=t_max)
            _ephemeris.filter_to_segments(segment_ranges)
            planets[n] = p.update_ephemeris(_ephemeris)

    print(f"\nUsing linear ephemeris for all {NPL} planets (no external TTV catalog for TESS)")

    # TESS time label for plots
    time_label = "Time [BTJD]"

    # quicklook litecurve
    _filepath = os.path.join(context.quicklook_dir, f"{target}_litecurve_raw.png")
    _ = plot_litecurve(litecurve_master, target, planets, _filepath, time_label=time_label)

    # enforce (t_min, t_max) consistency on litecurve and planets
    for n, p in enumerate(planets):
        p.ephemeris.clip_range(t_min, t_max)
        p.ephemeris.set_static_references()
        planets[n] = p.update_ephemeris(p.ephemeris)

        print(f"  Planet {n} : {len(p.ephemeris.ttime)} transits")

    # track TTV scatter and TTV buffer
    ttv_scatter = [None]*NPL
    ttv_buffer = [None]*NPL

    for n, p in enumerate(planets):
        ttv_scatter[n] = mad_std(p.ephemeris.ttime - p.ephemeris.eval_linear_ephemeris())
        ttv_buffer[n] = set_sigma_cutoff(len(p.ephemeris.ttime)) * ttv_scatter[n]

    return
