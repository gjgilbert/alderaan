import os

import numpy as np
from astropy.stats import mad_std

from alderaan.data_models.litecurve import LiteCurve
from alderaan.data_models.planet import Planet
from alderaan.modules.quicklook import plot_litecurve
from alderaan.utils.io import parse_holczer16_catalog, parse_koi_catalog
from alderaan.utils.pipeline import capture_locals
from alderaan.utils.stats import robust_polyfit, set_sigma_cutoff


@capture_locals
def run(context):
    print("\n\nSUBRECIPE: LOAD KEPLER DATA\n")

    # infer context
    target = context.target

    # load KOI catalog
    catalog = parse_koi_catalog(context.catalog_filepath, target)

    assert np.all(np.diff(catalog.period) > 0), (
        "Planets should be ordered by ascending period"
    )

    NPL = int(catalog.npl[0])
    koi_id = catalog.koi_id[0]
    kic_id = int(catalog.kic_id[0])
    limbdark = [catalog.limbdark_1[0], catalog.limbdark_2[0]]

    # load lightcurves
    litecurve_master = LiteCurve().from_kplr_pdcsap(
        context.data_dir, kic_id, "long cadence", visits=[1, 2, 3]
    )

    t_min = litecurve_master.time.min()
    t_max = litecurve_master.time.max()
    if t_min < 0:
        raise ValueError(
            "Lightcurve has negative timestamps...this will cause problems"
        )

    # split litecurves by quarter
    litecurves = litecurve_master.split_visits()

    for j, lc in enumerate(litecurves):
        assert len(np.unique(lc.visit)) == 1, "expected one quarter per litecurve"
        assert len(np.unique(lc.obsmode)) == 1, "expected one obsmode per litecurve"

    print(f"{len(litecurves)} litecurves loaded for {target}")

    # initialize planets
    planets = [None] * NPL
    for n in range(NPL):
        planets[n] = Planet(
            catalog.period[n],
            catalog.epoch[n],
            catalog.depth[n],
            catalog.duration[n],
            catalog.impact[n],
            t_min,
            t_max,
        )

    print(f"\n{NPL} planets loaded for {target}")
    print([np.round(p.period, 6) for p in planets])

    # load Holczer+2016 catalog
    _filepath = os.path.join(context.catalog_dir, "holczer_2016_kepler_ttvs.txt")
    holczer_ephemerides = parse_holczer16_catalog(_filepath, koi_id, NPL)

    print(f"\n{len(holczer_ephemerides)} ephemerides found in Holczer+2016")

    # match Holczer ephemerides to Planets
    _count = 0
    for n, p in enumerate(planets):
        for _index, _ttime, _error in holczer_ephemerides:
            _period = robust_polyfit(_index, _ttime, 1)[0]
            _match = np.isclose(_period, p.period, rtol=0.01, atol=p.duration)

            if _match:
                print(f"  Planet {n} : {p.period:.6f} --> {_period:.6f}")
                planets[n] = p.set_transit_times(_index, _ttime, _error)
                _count += 1

    print(f"{_count} matching ephemerides found ({len(holczer_ephemerides)} expected)")

    # quicklook litecurve
    _filepath = os.path.join(context.quicklook_dir, f"{target}_litecurve_raw.png")
    _ = plot_litecurve(litecurve_master, target, planets, _filepath)

    # enforce (t_min, t_max) consistency on litecurve and planets
    for n, p in enumerate(planets):
        p.clip_range(t_min, t_max)
        p.set_reference_period_and_epoch()
        planets[n] = p.refit_period_and_epoch()

        print(f"  Planet {n} : {len(p.transit_times)} transits")

    # track TTV scatter and TTV buffer
    ttv_scatter = [None] * NPL
    ttv_buffer = [None] * NPL

    for n, p in enumerate(planets):
        ttv_scatter[n] = mad_std(p.transit_times - p.eval_linear_ephemeris())
        ttv_buffer[n] = set_sigma_cutoff(len(p.transit_times)) * ttv_scatter[n]

    return
